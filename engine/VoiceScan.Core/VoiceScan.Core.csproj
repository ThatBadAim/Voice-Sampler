<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Default build is CPU-only. Build with -p:VoiceScanGpu=true for the CUDA 12 / cuDNN 9 runtime (Windows and Linux). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" Condition="'$(VoiceScanGpu)' != 'true'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.20.1" Condition="'$(VoiceScanGpu)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Model checksums are compiled in so ModelIntegrity never trusts a manifest found next to a model file. -->
    <EmbeddedResource Include="..\..\models\manifest.json" LogicalName="VoiceScan.Core.models.manifest.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VoiceScan.Tests" />
  </ItemGroup>

</Project>
