<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VoiceScan.App.Core.ViewModels"
             xmlns:m="using:VoiceScan.App.Core.Models"
             xmlns:c="using:VoiceScan.App.Controls"
             xmlns:svc="using:VoiceScan.App.Services"
             x:Class="VoiceScan.App.Views.ResultsView"
             x:DataType="vm:ResultsViewModel">

    <Grid x:Name="Split" ColumnDefinitions="360,40,*">
        <Border x:Name="ListPane" Classes="panel">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,20">
                    <TextBlock Text="Results" Classes="heading" />
                    <TextBox Text="{Binding SearchQuery}" PlaceholderText="Search files…" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <ComboBox x:Name="FilterCombo" HorizontalAlignment="Stretch" SelectedItem="{Binding SelectedFilter}" />
                        <ComboBox x:Name="SortCombo" Grid.Column="1" HorizontalAlignment="Stretch" SelectedItem="{Binding SelectedSort}" />
                    </Grid>
                    <CheckBox Content="Descending" IsChecked="{Binding SortDescending}" />
                    <Button Content="Export report…" Click="Export_Click" HorizontalAlignment="Stretch"
                            IsEnabled="{Binding HasResults}"
                            ToolTip.Tip="Saves a CSV, a PDF and the matching audio clips." />
                    <TextBlock Text="{Binding ExportStatus}" Classes="secondary" TextWrapping="Wrap" />
                </StackPanel>
                <ListBox ItemsSource="{Binding FilteredFiles}" SelectedItem="{Binding SelectedFile}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:FileVerdictResult">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Classes="badge" Background="{Binding OverallVerdict, Converter={x:Static svc:VerdictConverters.Background}}">
                                        <TextBlock Text="{Binding OverallVerdict}" Foreground="{Binding OverallVerdict, Converter={x:Static svc:VerdictConverters.Foreground}}" />
                                    </Border>
                                    <TextBlock Text="{Binding MaxConfidence, StringFormat={}{0:P0}}" Classes="secondary" IsVisible="{Binding !IsError}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding IsError}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource VerdictErrorBrush}" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border x:Name="DetailPane" Grid.Column="2" Classes="panel" IsVisible="{Binding HasSelectedFile}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,24">
                    <TextBlock Text="{Binding SelectedFile.FileName}" Classes="title" FontSize="20" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SelectedFile.FilePath}" Classes="secondary" TextTrimming="CharacterEllipsis" />
                    <Border HorizontalAlignment="Left" Classes="badge" Background="{Binding SelectedFile.OverallVerdict, Converter={x:Static svc:VerdictConverters.Background}}"><TextBlock Text="{Binding SelectedFile.OverallVerdict}" Foreground="{Binding SelectedFile.OverallVerdict, Converter={x:Static svc:VerdictConverters.Foreground}}" /></Border>
                    <TextBlock Text="{Binding SelectedFile.ErrorMessage}" IsVisible="{Binding SelectedFile.IsError}" TextWrapping="Wrap"
                               Foreground="{DynamicResource VerdictErrorBrush}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,16">
                    <c:WaveformTimelineControl x:Name="Timeline" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="PlayPauseButton" Classes="primary" Click="PlayPause_Click"
                                IsEnabled="{Binding IsAudioAvailable}"
                                ToolTip.Tip="Audio playback needs ffplay (install ffmpeg) on PATH.">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon x:Name="PlayPauseIcon" Data="{StaticResource IconPlay}" />
                                <TextBlock x:Name="PlayPauseText" Text="Play" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="PositionText" Text="00:00 / 00:00" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Segment Filters -->
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,0,0,16">
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{x:Static vm:ResultsViewModel.SegmentFilterModes}"
                              SelectedItem="{Binding SelectedSegmentFilterMode}" />
                    <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding AvailableSpeakers}"
                              SelectedItem="{Binding SelectedSpeaker}" />
                </Grid>

                <!-- Inspector Panel for Selected Segment -->
                <Border DockPanel.Dock="Bottom" Classes="card" IsVisible="{Binding HasSelectedSegment}" Margin="0,16,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Segment Inspector" Classes="heading" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding SelectedSegment.StartTimeSeconds, StringFormat='{}{0:F1}s'}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedSegment.EndTimeSeconds, StringFormat='– {0:F1}s'}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedSegment.DurationSeconds, StringFormat='({0:F1}s)'}" Classes="secondary" VerticalAlignment="Center" />
                            <!-- Pill tag with speaker identifier -->
                            <Border Classes="badge" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                    IsVisible="{Binding SelectedSegment.DisplaySpeakerLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding SelectedSegment.DisplaySpeakerLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <!-- Warning badge indicating violated moderation policy categories -->
                            <Border Classes="badge" Background="{DynamicResource VerdictErrorSoftBrush}" IsVisible="{Binding SelectedSegment.IsFlagged}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource IconShield}" Width="12" Height="12" Foreground="{DynamicResource VerdictErrorBrush}" />
                                    <TextBlock Text="{Binding SelectedSegment.ViolationsSummary}" Foreground="{DynamicResource VerdictErrorBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Transcribed text in selectable text block -->
                        <StackPanel Spacing="4" IsVisible="{Binding SelectedSegment.Transcript, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="Transcript" Classes="secondary" FontSize="11" />
                            <SelectableTextBlock Text="{Binding SelectedSegment.Transcript}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Audio playback scrub buttons seeking to Segment.Start -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Click="PlaySelectedSegment_Click" IsEnabled="{Binding IsAudioAvailable}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconPlay}" />
                                    <TextBlock Text="Play Segment" />
                                </StackPanel>
                            </Button>
                            <Button Click="ScrubToSegmentStart_Click" IsEnabled="{Binding IsAudioAvailable}">
                                <TextBlock Text="Seek to Start" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Segments List -->
                <ListBox x:Name="SegmentsList" ItemsSource="{Binding FilteredSegments}" SelectedItem="{Binding SelectedSegment}" SelectionChanged="Segments_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="m:HitSegmentResult">
                            <StackPanel Spacing="6" Margin="0,4">
                                <Grid ColumnDefinitions="110,80,70,Auto,Auto,*">
                                    <TextBlock Text="{Binding StartTimeSeconds, StringFormat={}{0:F1}s}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Classes="badge" HorizontalAlignment="Left" Background="{Binding Verdict, Converter={x:Static svc:VerdictConverters.Background}}">
                                        <TextBlock Text="{Binding Verdict}" Foreground="{Binding Verdict, Converter={x:Static svc:VerdictConverters.Foreground}}" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Confidence, StringFormat={}{0:F3}}" VerticalAlignment="Center" Classes="secondary" />
                                    <!-- Speaker pill tag -->
                                    <Border Grid.Column="3" Classes="badge" Background="{DynamicResource SurfaceRaisedBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                            IsVisible="{Binding DisplaySpeakerLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding DisplaySpeakerLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                    <!-- Warning badge indicating violated moderation policy categories -->
                                    <Border Grid.Column="4" Classes="badge" Background="{DynamicResource VerdictErrorSoftBrush}" IsVisible="{Binding IsFlagged}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="{StaticResource IconShield}" Width="10" Height="10" Foreground="{DynamicResource VerdictErrorBrush}" />
                                            <TextBlock Text="{Binding ViolationsSummary}" Foreground="{DynamicResource VerdictErrorBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <!-- Transcribed text in a selectable text block -->
                                <SelectableTextBlock Text="{Binding Transcript}" TextWrapping="Wrap"
                                                     IsVisible="{Binding Transcript, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <TextBlock x:Name="EmptyText" Grid.Column="2" Text="Scan some recordings, then select a file to see where the voice appears." Classes="subtitle"
                   IsVisible="{Binding !HasSelectedFile}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
