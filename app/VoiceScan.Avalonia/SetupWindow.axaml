<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VoiceScan.App.SetupWindow"
        Title="VoiceScan setup"
        Width="720" Height="640" CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">

    <StackPanel Margin="56" Spacing="36" VerticalAlignment="Center">
        <StackPanel Spacing="12">
            <TextBlock Text="Setup" Classes="title" />
        </StackPanel>

        <Border x:Name="ModelsCard" Classes="card">
            <StackPanel Spacing="16">
                <TextBlock Text="Voice models" Classes="heading" />
                <TextBlock x:Name="ModelsText" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Classes="primary" Content="Locate models folder…" Click="LocateModels_Click"
                            ToolTip.Tip="Pick a folder that contains the model files; VoiceScan finds and copies the ones it needs." />
                    <Button Content="Choose files…" Click="ChooseModels_Click" />
                    <Button Content="Open models folder" Click="OpenModels_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="ToolsCard" Classes="card">
            <StackPanel Spacing="16">
                <TextBlock Text="FFmpeg" Classes="heading" />
                <TextBlock x:Name="ToolsText" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="StatusText" Classes="secondary" TextWrapping="Wrap" />
        <Button Classes="primary" HorizontalAlignment="Left" Padding="28,12" Content="Check again" Click="CheckAgain_Click" />
    </StackPanel>
</Window>
