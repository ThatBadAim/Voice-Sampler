<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <Color x:Key="BrandPrimaryColor">#4F7CFF</Color>
            <Color x:Key="VerdictMatchColor">#22A06B</Color>
            <Color x:Key="VerdictPossibleColor">#E08A1E</Color>
            <Color x:Key="VerdictNoMatchColor">#7A8794</Color>
            <Color x:Key="TimelineCursorColor">#38BDF8</Color>
            <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
            <SolidColorBrush x:Key="VerdictMatchBrush" Color="{StaticResource VerdictMatchColor}" />
            <SolidColorBrush x:Key="VerdictPossibleBrush" Color="{StaticResource VerdictPossibleColor}" />
            <SolidColorBrush x:Key="VerdictNoMatchBrush" Color="{StaticResource VerdictNoMatchColor}" />
            <SolidColorBrush x:Key="TimelineCursorBrush" Color="{StaticResource TimelineCursorColor}" />
            <SolidColorBrush x:Key="VerdictMatchSoftBrush" Color="#22A06B" Opacity="0.16" />
            <SolidColorBrush x:Key="VerdictPossibleSoftBrush" Color="#E08A1E" Opacity="0.18" />
            <SolidColorBrush x:Key="VerdictNoMatchSoftBrush" Color="#7A8794" Opacity="0.18" />
            <SolidColorBrush x:Key="BrandSoftBrush" Color="#4F7CFF" Opacity="0.14" />

            <CornerRadius x:Key="CardRadius">10</CornerRadius>
            <CornerRadius x:Key="ControlRadius">7</CornerRadius>

            <!-- 24x24 outline icons -->
            <StreamGeometry x:Key="IconScan">M11 4a7 7 0 1 0 4.2 12.6l4.6 4.6 1.4-1.4-4.6-4.6A7 7 0 0 0 11 4zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10z</StreamGeometry>
            <StreamGeometry x:Key="IconResults">M4 20V10h3v10H4zm6.5 0V4h3v16h-3zM17 20v-7h3v7h-3z</StreamGeometry>
            <StreamGeometry x:Key="IconReview">M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm-1.3 14.3L6.4 12l1.4-1.4 2.9 2.9 5.5-5.5 1.4 1.4-6.9 6.9z</StreamGeometry>
            <StreamGeometry x:Key="IconMic">M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.9V21h2v-3.1A7 7 0 0 0 19 11h-2z</StreamGeometry>
            <StreamGeometry x:Key="IconTheme">M12 3a9 9 0 1 0 9 9c0-.5 0-.9-.1-1.4A5.5 5.5 0 0 1 12.4 3.1 9 9 0 0 0 12 3z</StreamGeometry>
            <StreamGeometry x:Key="IconLock">M17 9h-1V7a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2zm-7-2a2 2 0 0 1 4 0v2h-4V7z</StreamGeometry>
            <StreamGeometry x:Key="IconPlay">M8 5v14l11-7z</StreamGeometry>
            <StreamGeometry x:Key="IconPause">M6 5h4v14H6zM14 5h4v14h-4z</StreamGeometry>
            <StreamGeometry x:Key="IconStop">M6 6h12v12H6z</StreamGeometry>
            <StreamGeometry x:Key="IconFolder">M3 6a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6z</StreamGeometry>
            <StreamGeometry x:Key="IconCheck">M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z</StreamGeometry>
            <StreamGeometry x:Key="IconClose">M19 6.4L17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12z</StreamGeometry>
            <StreamGeometry x:Key="IconSparkle">M12 2l2.2 6.8L21 11l-6.8 2.2L12 20l-2.2-6.8L3 11l6.8-2.2z</StreamGeometry>
            <StreamGeometry x:Key="IconShield">M12 2L4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3z</StreamGeometry>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F6F9" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F0F2F6" />
                    <SolidColorBrush x:Key="SurfaceCardBorderBrush" Color="#E2E6EC" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#18202B" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5E6B7A" />
                    <SolidColorBrush x:Key="WaveformBarBrush" Color="#8392A5" />
                    <SolidColorBrush x:Key="WaveformBackgroundBrush" Color="#EAEEF4" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0E1116" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#12161C" />
                    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#171C23" />
                    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1E242D" />
                    <SolidColorBrush x:Key="SurfaceCardBorderBrush" Color="#262D37" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8ECF1" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B97A6" />
                    <SolidColorBrush x:Key="WaveformBarBrush" Color="#6B7A8E" />
                    <SolidColorBrush x:Key="WaveformBackgroundBrush" Color="#10141A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Typography -->
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-0.3" />
    </Style>
    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.metric-label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.8" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.metric-value">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-0.4" />
    </Style>

    <!-- Surfaces -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.callout">
        <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Padding" Value="14" />
    </Style>
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Buttons -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#6490FF" />
        <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#3E68E6" />
    </Style>
    <Style Selector="Button.accent:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <!-- Icons -->
    <Style Selector="PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <!-- Sidebar navigation -->
    <Style Selector="Button.nav">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav.active">
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter, Button.nav.active:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandSoftBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
    </Style>

    <!-- Inputs & lists -->
    <Style Selector="TextBox, ComboBox">
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    </Style>
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="ProgressBar">
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="ProgressBar /template/ Border#PART_Indicator">
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource SurfaceCardBorderBrush}" />
    </Style>
    <Style Selector="Border.divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SurfaceCardBorderBrush}" />
    </Style>

</Styles>
