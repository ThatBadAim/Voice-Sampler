<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:styles="using:VoiceScan.App.Styles">

    <Styles.Resources>
        <ResourceDictionary>
            <Color x:Key="VerdictMatchColor">#4E9F7D</Color>
            <Color x:Key="VerdictPossibleColor">#C9923A</Color>
            <Color x:Key="VerdictNoMatchColor">#8A857C</Color>
            <Color x:Key="VerdictErrorColor">#C4584E</Color>
            <SolidColorBrush x:Key="VerdictErrorBrush" Color="{StaticResource VerdictErrorColor}" />
            <SolidColorBrush x:Key="VerdictMatchBrush" Color="{StaticResource VerdictMatchColor}" />
            <SolidColorBrush x:Key="VerdictPossibleBrush" Color="{StaticResource VerdictPossibleColor}" />
            <SolidColorBrush x:Key="VerdictNoMatchBrush" Color="{StaticResource VerdictNoMatchColor}" />
            <SolidColorBrush x:Key="VerdictMatchSoftBrush" Color="#4E9F7D" Opacity="0.14" />
            <SolidColorBrush x:Key="VerdictPossibleSoftBrush" Color="#C9923A" Opacity="0.14" />
            <SolidColorBrush x:Key="VerdictNoMatchSoftBrush" Color="#8A857C" Opacity="0.14" />
            <SolidColorBrush x:Key="VerdictErrorSoftBrush" Color="#C4584E" Opacity="0.14" />

            <CornerRadius x:Key="PanelRadius">8</CornerRadius>
            <CornerRadius x:Key="ControlRadius">6</CornerRadius>

            <!-- 24x24 outline icons -->
            <StreamGeometry x:Key="IconScan">M11 4a7 7 0 1 0 4.2 12.6l4.6 4.6 1.4-1.4-4.6-4.6A7 7 0 0 0 11 4zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10z</StreamGeometry>
            <StreamGeometry x:Key="IconResults">M4 20V10h3v10H4zm6.5 0V4h3v16h-3zM17 20v-7h3v7h-3z</StreamGeometry>
            <StreamGeometry x:Key="IconReview">M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm-1.3 14.3L6.4 12l1.4-1.4 2.9 2.9 5.5-5.5 1.4 1.4-6.9 6.9z</StreamGeometry>
            <StreamGeometry x:Key="IconMic">M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.9V21h2v-3.1A7 7 0 0 0 19 11h-2z</StreamGeometry>
            <StreamGeometry x:Key="IconTheme">M12 3a9 9 0 1 0 9 9c0-.5 0-.9-.1-1.4A5.5 5.5 0 0 1 12.4 3.1 9 9 0 0 0 12 3z</StreamGeometry>
            <StreamGeometry x:Key="IconLock">M17 9h-1V7a4 4 0 0 0-8 0v2H7a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-8a2 2 0 0 0-2-2zm-7-2a2 2 0 0 1 4 0v2h-4V7z</StreamGeometry>
            <StreamGeometry x:Key="IconPlay">M8 5v14l11-7z</StreamGeometry>
            <StreamGeometry x:Key="IconPause">M6 5h4v14H6zM14 5h4v14h-4z</StreamGeometry>
            <StreamGeometry x:Key="IconStop">M6 6h12v12H6z</StreamGeometry>
            <StreamGeometry x:Key="IconFolder">M3 6a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6z</StreamGeometry>
            <StreamGeometry x:Key="IconCheck">M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z</StreamGeometry>
            <StreamGeometry x:Key="IconClose">M19 6.4L17.6 5 12 10.6 6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12z</StreamGeometry>
            <StreamGeometry x:Key="IconSparkle">M12 2l2.2 6.8L21 11l-6.8 2.2L12 20l-2.2-6.8L3 11l6.8-2.2z</StreamGeometry>
            <StreamGeometry x:Key="IconShield">M12 2L4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3z</StreamGeometry>
            <StreamGeometry x:Key="IconAlert">M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z</StreamGeometry>
            <StreamGeometry x:Key="IconClip">M4 4h16v16H4V4zm2 2v2h2V6H6zm0 5v2h2v-2H6zm0 5v2h2v-2H6zm10-10v2h2V6h-2zm0 5v2h2v-2h-2zm0 5v2h2v-2h-2zM10 8v8l5-4-5-4z</StreamGeometry>
            <StreamGeometry x:Key="IconPeople">M16 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm-8 0a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm0 2c-2.7 0-8 1.3-8 4v3h16v-3c0-2.7-5.3-4-8-4zm8 0c-.3 0-.7 0-1.1.1 1.2.8 2.1 2 2.1 3.9v3h7v-3c0-2.7-5.3-4-8-4z</StreamGeometry>
            <StreamGeometry x:Key="IconModel">M15 9H9v6h6V9zm-2 4h-2v-2h2v2zm8-2V9h-2V7c0-1.1-.9-2-2-2h-2V3h-2v2h-2V3H9v2H7c-1.1 0-2 .9-2 2v2H3v2h2v2H3v2h2v2c0 1.1.9 2 2 2h2v2h2v-2h2v2h2v-2h2c1.1 0 2-.9 2-2v-2h2v-2h-2v-2h2zm-4 6H7V7h10v10z</StreamGeometry>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F6F3EE" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#EFEBE4" />
                    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#EDE9E1" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#DDD7CC" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D1B18" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6F695F" />
                    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#B5502E" />
                    <SolidColorBrush x:Key="BrandHoverBrush" Color="#C45E3B" />
                    <SolidColorBrush x:Key="BrandPressedBrush" Color="#9E4325" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#151412" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#1A1917" />
                    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1F1D1A" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#2D2A26" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECE8E0" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8F897E" />
                    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#D2704F" />
                    <SolidColorBrush x:Key="BrandHoverBrush" Color="#DE805F" />
                    <SolidColorBrush x:Key="BrandPressedBrush" Color="#BC5F40" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="{x:Static styles:AppThemeVariants.Ocean}">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0F151C" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#131A22" />
                    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#18212B" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#26323F" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E3EAF0" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#85919E" />
                    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#3F8DBB" />
                    <SolidColorBrush x:Key="BrandHoverBrush" Color="#52A0CE" />
                    <SolidColorBrush x:Key="BrandPressedBrush" Color="#33789F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="{x:Static styles:AppThemeVariants.Forest}">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#121611" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#161B15" />
                    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1C221A" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#2A3228" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E4EAE1" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8A9486" />
                    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#4F9A5F" />
                    <SolidColorBrush x:Key="BrandHoverBrush" Color="#62AC72" />
                    <SolidColorBrush x:Key="BrandPressedBrush" Color="#40844F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="{x:Static styles:AppThemeVariants.Violet}">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#16131C" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#1B1822" />
                    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#211D29" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#302B3B" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8E4F0" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#90899E" />
                    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#8F6CD0" />
                    <SolidColorBrush x:Key="BrandHoverBrush" Color="#A180DC" />
                    <SolidColorBrush x:Key="BrandPressedBrush" Color="#7A58B8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="{x:Static styles:AppThemeVariants.Graphite}">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#121212" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#171717" />
                    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1D1D1D" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#2C2C2C" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECECEC" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8C8C8C" />
                    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#5F6B7A" />
                    <SolidColorBrush x:Key="BrandHoverBrush" Color="#707C8B" />
                    <SolidColorBrush x:Key="BrandPressedBrush" Color="#4F5A68" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="{x:Static styles:AppThemeVariants.Mist}">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F1F4F7" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#E8EDF2" />
                    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#E1E7ED" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#CDD6DF" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A2027" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5E6A77" />
                    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#2F6DB0" />
                    <SolidColorBrush x:Key="BrandHoverBrush" Color="#3F7DC0" />
                    <SolidColorBrush x:Key="BrandPressedBrush" Color="#265C99" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- Typography -->
    <Style Selector="TextBlock">
        <Setter Property="LineHeight" Value="22" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="LineHeight" Value="40" />
        <Setter Property="LetterSpacing" Value="-0.6" />
    </Style>
    <Style Selector="TextBlock.heading">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style Selector="TextBlock.subtitle">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.metric-label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LetterSpacing" Value="1.2" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.metric-value">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="LineHeight" Value="38" />
        <Setter Property="LetterSpacing" Value="-0.6" />
    </Style>

    <!-- Surfaces: sections are separated by space and a hairline, not boxes -->
    <Style Selector="Border.card">
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,32,0,0" />
    </Style>
    <Style Selector="Border.card, Border.panel, Border.callout">
        <Setter Property="RenderTransform">
            <TranslateTransform />
        </Setter>
        <Style.Animations>
            <Animation Duration="0:0:0.38" Easing="CubicEaseOut" FillMode="Both">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="TranslateTransform.Y" Value="14" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="TranslateTransform.Y" Value="0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="Border.callout">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge > TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="16" />
    </Style>

    <!-- Buttons: quiet outline by default, one solid accent per screen -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button /template/ ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="CubicEaseOut" />
                <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.02)" />
    </Style>
    <Style Selector="Button:pressed">
        <Setter Property="RenderTransform" Value="scale(0.95)" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandPressedBrush}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Opacity" Value="0.35" />
        <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <!-- Theme picker swatches -->
    <Style Selector="Button.swatch">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.swatch-chip">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
    </Style>

    <!-- Icons -->
    <Style Selector="PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <!-- Sidebar navigation -->
    <Style Selector="Button.nav">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.nav:pointerover">
        <Setter Property="RenderTransform" Value="translateX(3px)" />
    </Style>
    <Style Selector="Button.nav:pressed">
        <Setter Property="RenderTransform" Value="translateX(1px) scale(0.98)" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav.active">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter, Button.nav.active:pointerover /template/ ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Border#NavIndicator">
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="Width" Value="2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Compact window: icon-only sidebar -->
    <Style Selector="Window.compact TextBlock.navlabel">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Window.compact Button.nav:pointerover">
        <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>
    <Style Selector="Window.compact Button.nav">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0,14" />
    </Style>

    <!-- Inputs & lists -->
    <Style Selector="TextBox, ComboBox">
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement, ComboBox /template/ Border#Background">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="CheckBox /template/ Border#NormalRectangle">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem /template/ ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="ProgressBar">
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="ProgressBar /template/ Border#PART_Indicator">
        <Setter Property="CornerRadius" Value="2" />
    </Style>
    <Style Selector="Expander">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,8" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="Padding" Value="10,0,0,0" />
    </Style>
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource HairlineBrush}" />
    </Style>
    <Style Selector="Border.divider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource HairlineBrush}" />
    </Style>

</Styles>
