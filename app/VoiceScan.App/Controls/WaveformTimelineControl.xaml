<UserControl
    x:Class="VoiceScan.App.Controls.WaveformTimelineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Background="#1E1E1E" CornerRadius="6" Height="140" PointerPressed="Timeline_PointerPressed">
        <!-- Canvas for Waveform and Hit Highlights -->
        <Canvas x:Name="WaveformCanvas" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <!-- Overlay Playback Cursor Line -->
        <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Line x:Name="PlaybackCursorLine"
                  X1="0" Y1="0" X2="0" Y2="140"
                  Stroke="{ThemeResource TimelineCursorBrush}"
                  StrokeThickness="2" />
        </Canvas>

        <!-- Time Axis Markers -->
        <Grid VerticalAlignment="Bottom" Margin="8,0,8,4">
            <TextBlock x:Name="StartTimeText" Text="00:00" FontSize="11" Foreground="#888888" HorizontalAlignment="Left" />
            <TextBlock x:Name="CurrentTimeText" Text="00:00" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TimelineCursorBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="TotalTimeText" Text="--:--" FontSize="11" Foreground="#888888" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</UserControl>
