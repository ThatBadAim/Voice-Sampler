<Page
    x:Class="VoiceScan.App.Views.ScanDashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:VoiceScan.App.Core.Models">

    <Grid RowDefinitions="Auto,Auto,*" Margin="8">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
            <TextBlock Text="Scan Dashboard" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <TextBlock Text="Execute high-throughput offline biometric scans over recordings and multi-hour streams." Style="{StaticResource SubtitleTextBlockStyle}" />
        </StackPanel>

        <!-- Configuration Bar -->
        <Border Grid.Row="1" Background="{ThemeResource SurfaceCardBrush}" BorderBrush="{ThemeResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel Spacing="16">
                <Grid ColumnDefinitions="*,*,Auto">
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Target Audio Folder or Files" Style="{StaticResource MetricLabelTextBlockStyle}" Margin="0,0,0,4" />
                        <TextBox x:Name="TargetFolderInput" Text="eval/dev_dataset" PlaceholderText="Select directory with audio files..." />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Target Voice Profile" Style="{StaticResource MetricLabelTextBlockStyle}" Margin="0,0,0,4" />
                        <TextBox x:Name="ProfilePathInput" Text="eval/dev_dataset/profiles/speaker_alpha.json" PlaceholderText="Path to voice profile (.json)..." />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="8">
                        <Button x:Name="StartScanButton" Content="▶️ Start Scan" Click="StartScanButton_Click" Style="{StaticResource AccentButtonStyle}" Padding="16,8" />
                        <Button x:Name="PauseResumeButton" Content="⏸️ Pause" Click="PauseResumeButton_Click" IsEnabled="False" />
                        <Button x:Name="CancelButton" Content="⏹️ Cancel" Click="CancelButton_Click" IsEnabled="False" />
                    </StackPanel>
                </Grid>

                <!-- Advanced Options Checkboxes -->
                <StackPanel Orientation="Horizontal" Spacing="24">
                    <CheckBox x:Name="ClusteringCheckBox" Content="Within-file speaker clustering (AHC, τ=0.40)" IsChecked="True" />
                    <CheckBox x:Name="TemporalSmoothingCheckBox" Content="Temporal smoothing &amp; neighbor support" IsChecked="True" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Live Scan Execution & Metrics -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*" ColumnDefinitions="2*,*">
            <!-- Left: Progress & Metrics -->
            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="16" Margin="0,0,16,16">
                <!-- Telemetry Cards -->
                <Grid ColumnDefinitions="*,*,*,*">
                    <Border Grid.Column="0" Background="{ThemeResource SurfaceCardBrush}" BorderBrush="{ThemeResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="SPEED MULTIPLE" Style="{StaticResource MetricLabelTextBlockStyle}" />
                            <TextBlock x:Name="SpeedMultipleText" Text="0.0x" Style="{StaticResource MetricValueTextBlockStyle}" Foreground="{ThemeResource BrandPrimaryBrush}" />
                            <TextBlock Text="Realtime throughput" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{ThemeResource SurfaceCardBrush}" BorderBrush="{ThemeResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="ESTIMATED TIME (ETA)" Style="{StaticResource MetricLabelTextBlockStyle}" />
                            <TextBlock x:Name="EtaText" Text="--:--" Style="{StaticResource MetricValueTextBlockStyle}" />
                            <TextBlock Text="Remaining scan time" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{ThemeResource SurfaceCardBrush}" BorderBrush="{ThemeResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="GPU UTILIZATION" Style="{StaticResource MetricLabelTextBlockStyle}" />
                            <TextBlock x:Name="GpuUtilText" Text="-- %" Style="{StaticResource MetricValueTextBlockStyle}" Foreground="#107C41" />
                            <TextBlock Text="ONNX Runtime CUDA" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="{ThemeResource SurfaceCardBrush}" BorderBrush="{ThemeResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <TextBlock Text="FILES COMPLETED" Style="{StaticResource MetricLabelTextBlockStyle}" />
                            <TextBlock x:Name="FilesCompletedText" Text="0 / 0" Style="{StaticResource MetricValueTextBlockStyle}" />
                            <TextBlock Text="Batch progress" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Progress Bars -->
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="CurrentFileStatusText" Text="Ready to scan." FontWeight="Medium" />
                        <TextBlock x:Name="OverallPercentText" Grid.Column="1" Text="0%" FontWeight="Bold" />
                    </Grid>
                    <ProgressBar x:Name="OverallProgressBar" Minimum="0" Maximum="100" Value="0" Height="8" />
                </StackPanel>
            </StackPanel>

            <!-- Right: Verdict Summary Cards -->
            <Border Grid.Row="0" Grid.Column="1" Background="{ThemeResource SurfaceCardBrush}" BorderBrush="{ThemeResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Detection Summary" FontWeight="SemiBold" FontSize="16" />
                    <Grid ColumnDefinitions="*,*,*">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="MATCH" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource VerdictMatchBrush}" />
                            <TextBlock x:Name="MatchCountText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource VerdictMatchBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="POSSIBLE" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource VerdictPossibleBrush}" />
                            <TextBlock x:Name="PossibleCountText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource VerdictPossibleBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="NO MATCH" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource VerdictNoMatchBrush}" />
                            <TextBlock x:Name="NoMatchCountText" Text="0" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource VerdictNoMatchBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bottom: Live Scanned Files List -->
            <ListView Grid.Row="1" Grid.ColumnSpan="2" x:Name="ScannedFilesListView" Background="{ThemeResource SurfaceCardBrush}" BorderBrush="{ThemeResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:FileVerdictResult">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Padding="8,4">
                            <!-- Verdict Badge -->
                            <Border Grid.Column="0" CornerRadius="4" Padding="8,3" Margin="0,0,12,0" Background="{ThemeResource VerdictMatchBrush}">
                                <TextBlock Text="{x:Bind OverallVerdict}" Foreground="White" FontWeight="Bold" FontSize="11" />
                            </Border>

                            <!-- File Name -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind FileName}" FontWeight="Medium" />
                                <TextBlock Text="{x:Bind FilePath}" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Hits -->
                            <TextBlock Grid.Column="2" Text="{x:Bind Segments.Count, Mode=OneWay}" VerticalAlignment="Center" Margin="12,0" FontWeight="SemiBold" />

                            <!-- Max Confidence -->
                            <TextBlock Grid.Column="3" Text="{x:Bind MaxConfidence, Mode=OneWay}" VerticalAlignment="Center" FontWeight="Bold" Width="60" TextAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
