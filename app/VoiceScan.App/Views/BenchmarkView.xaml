<Page
    x:Class="VoiceScan.App.Views.BenchmarkView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:VoiceScan.App.Core.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20" Margin="8">
            <!-- Header -->
            <StackPanel Spacing="6">
                <TextBlock Text="Empirical Benchmarks &amp; Verified Accuracy" Style="{StaticResource TitleLargeTextBlockStyle}" />
                <TextBlock Text="Performance metrics loaded directly from reproducible evaluation harness runs with 95% bootstrap confidence intervals." Style="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>

            <!-- Report Selector Card -->
            <Border Background="{ThemeResource SurfaceCardBrush}" BorderBrush="{ThemeResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="SELECT EVALUATION RUN" Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <ComboBox x:Name="ReportComboBox" SelectionChanged="ReportComboBox_SelectionChanged" HorizontalAlignment="Stretch" MaxWidth="500" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="StatusMessageText" FontSize="12" Foreground="{ThemeResource BrandPrimaryBrush}" FontWeight="Medium" />
                        <TextBlock x:Name="MetadataSummaryText" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Headline Metrics with 95% Confidence Intervals -->
            <Grid ColumnDefinitions="*,*,*,*">
                <!-- Recall -->
                <Border Grid.Column="0" Background="{ThemeResource SurfaceCardBrush}" BorderBrush="{ThemeResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="RECALL (TARGET PRESENT)" Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock x:Name="RecallValueText" Text="-- %" Style="{StaticResource MetricValueTextBlockStyle}" Foreground="{ThemeResource BrandPrimaryBrush}" />
                        <TextBlock x:Name="RecallCiText" Text="95% CI: [--%, --%]" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Precision -->
                <Border Grid.Column="1" Background="{ThemeResource SurfaceCardBrush}" BorderBrush="{ThemeResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="PRECISION" Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock x:Name="PrecisionValueText" Text="-- %" Style="{StaticResource MetricValueTextBlockStyle}" Foreground="{ThemeResource VerdictMatchBrush}" />
                        <TextBlock x:Name="PrecisionCiText" Text="95% CI: [--%, --%]" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- False Alarms / Hour -->
                <Border Grid.Column="2" Background="{ThemeResource SurfaceCardBrush}" BorderBrush="{ThemeResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="FALSE ALARMS / HOUR" Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock x:Name="FaValueText" Text="-- " Style="{StaticResource MetricValueTextBlockStyle}" Foreground="{ThemeResource VerdictPossibleBrush}" />
                        <TextBlock x:Name="FaCiText" Text="95% CI: [--, --]" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Processing Throughput -->
                <Border Grid.Column="3" Background="{ThemeResource SurfaceCardBrush}" BorderBrush="{ThemeResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="PROCESSING THROUGHPUT" Style="{StaticResource MetricLabelTextBlockStyle}" />
                        <TextBlock x:Name="SpeedValueText" Text="-- x" Style="{StaticResource MetricValueTextBlockStyle}" Foreground="#107C41" />
                        <TextBlock x:Name="HardwareText" Text="Realtime multiple" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Stratified SNR Breakdown Table -->
            <Border Background="{ThemeResource SurfaceCardBrush}" BorderBrush="{ThemeResource SurfaceCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Stratified Acoustic SNR Tier Breakdown" FontWeight="SemiBold" FontSize="18" />
                    <TextBlock Text="Performance breakdown across acoustic difficulty tiers demonstrating noise robustness." Style="{StaticResource BodyTextBlockStyle}" />

                    <!-- SNR Tiers Table -->
                    <ListView x:Name="SnrTiersListView">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="2*,*,*,*,*" Padding="8,4" Background="{ThemeResource SurfaceCardBorderBrush}" CornerRadius="4">
                                    <TextBlock Grid.Column="0" Text="Acoustic SNR Tier" FontWeight="Bold" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="Files" FontWeight="Bold" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="Recall (95% CI)" FontWeight="Bold" FontSize="12" />
                                    <TextBlock Grid.Column="3" Text="Precision (95% CI)" FontWeight="Bold" FontSize="12" />
                                    <TextBlock Grid.Column="4" Text="False Alarms / Hr" FontWeight="Bold" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SnrTierBenchmarkItem">
                                <Grid ColumnDefinitions="2*,*,*,*,*" Padding="8,8">
                                    <TextBlock Grid.Column="0" Text="{x:Bind TierName}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind TotalFiles}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Recall, Mode=OneWay}" FontWeight="Medium" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Precision, Mode=OneWay}" FontWeight="Medium" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind FaPerHour, Mode=OneWay}" FontWeight="Bold" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
