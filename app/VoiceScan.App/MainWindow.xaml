<Window
    x:Class="VoiceScan.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:VoiceScan.App.Views"
    Title="VoiceScan — Biometric Voice Locator (100% Offline)">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Scan Dashboard" Tag="Scan" Icon="Folder" />
                <NavigationViewItem Content="Results &amp; Timeline" Tag="Results" Icon="ViewAll" />
                <NavigationViewItem Content="Review Queue" Tag="Review" Icon="Accept" />
                <NavigationViewItem Content="Voice Enrollment" Tag="Enrollment" Icon="Audio" />
                <NavigationViewItem Content="Benchmark &amp; Accuracy" Tag="Benchmark" Icon="FourBars" />
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel Orientation="Vertical" Spacing="4" Margin="12,8">
                    <Button x:Name="ThemeToggleButton" Click="ThemeToggleButton_Click" Content="🌓 Toggle Theme" HorizontalAlignment="Stretch" />
                    <TextBlock Text="🔒 100% Offline Runtime" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" Margin="16" />
        </NavigationView>
    </Grid>
</Window>
