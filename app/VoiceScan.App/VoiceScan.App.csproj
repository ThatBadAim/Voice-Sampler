<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType Condition="'$(OS)' == 'Windows_NT'">WinExe</OutputType>
    <OutputType Condition="'$(OS)' != 'Windows_NT'">Library</OutputType>
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net8.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFramework>
    <TargetPlatformMinVersion Condition="'$(OS)' == 'Windows_NT'">10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>VoiceScan.App</RootNamespace>
    <ApplicationManifest Condition="'$(OS)' == 'Windows_NT'">app.manifest</ApplicationManifest>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifiers Condition="'$(OS)' == 'Windows_NT'">win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile Condition="'$(OS)' == 'Windows_NT'">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI Condition="'$(OS)' == 'Windows_NT'">true</UseWinUI>
    <EnableMsixTooling Condition="'$(OS)' == 'Windows_NT'">true</EnableMsixTooling>
    <WindowsAppSDKSelfContained Condition="'$(OS)' == 'Windows_NT'">true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoiceScan.App.Core\VoiceScan.App.Core.csproj" />
    <ProjectReference Include="..\..\engine\VoiceScan.Core\VoiceScan.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240428000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
  </ItemGroup>

  <!-- Non-Windows fallback: treat XAML and code-behind as content so dotnet build succeeds on Linux -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <Compile Remove="**\*.xaml.cs" />
    <None Include="**\*.xaml.cs" />
    <None Include="**\*.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
