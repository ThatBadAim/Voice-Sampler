<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Color Palette conforming to DESIGN.md -->
    <Color x:Key="BrandPrimaryColor">#0078D4</Color>
    <Color x:Key="VerdictMatchColor">#107C41</Color>
    <Color x:Key="VerdictPossibleColor">#D83B01</Color>
    <Color x:Key="VerdictNoMatchColor">#5D6B74</Color>
    <Color x:Key="TimelineCursorColor">#00E5FF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="VerdictMatchBrush" Color="{StaticResource VerdictMatchColor}" />
    <SolidColorBrush x:Key="VerdictPossibleBrush" Color="{StaticResource VerdictPossibleColor}" />
    <SolidColorBrush x:Key="VerdictNoMatchBrush" Color="{StaticResource VerdictNoMatchColor}" />
    <SolidColorBrush x:Key="TimelineCursorBrush" Color="{StaticResource TimelineCursorColor}" />

    <!-- Light Theme Overrides -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="#F3F3F3" Opacity="0.85" />
            <SolidColorBrush x:Key="SurfaceCardBorderBrush" Color="#E5E5E5" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#605E5C" />
            <SolidColorBrush x:Key="WaveformBarBrush" Color="#A19F9D" />
            <SolidColorBrush x:Key="WaveformHitMatchBrush" Color="#107C41" Opacity="0.4" />
            <SolidColorBrush x:Key="WaveformHitPossibleBrush" Color="#D83B01" Opacity="0.4" />
        </ResourceDictionary>

        <!-- Dark Theme Overrides -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="#202020" Opacity="0.80" />
            <SolidColorBrush x:Key="SurfaceCardBorderBrush" Color="#2D2D2D" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A6A6A6" />
            <SolidColorBrush x:Key="WaveformBarBrush" Color="#555555" />
            <SolidColorBrush x:Key="WaveformHitMatchBrush" Color="#107C41" Opacity="0.5" />
            <SolidColorBrush x:Key="WaveformHitPossibleBrush" Color="#D83B01" Opacity="0.5" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Typography Styles (Segoe UI Variable) -->
    <Style x:Key="TitleLargeTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="BodyTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="MetricLabelTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>

    <Style x:Key="MetricValueTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

</ResourceDictionary>
